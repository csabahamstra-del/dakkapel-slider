# Claude API
ANTHROPIC_API_KEY=

# Modelnamen — nooit hardcoden in code
EXTRACTION_MODEL=claude-haiku-4-5-20251001
NARRATIVE_MODEL=claude-sonnet-5-5
# Model voor het genereren van concept-labels in /eval (sterker dan het extractiemodel)
EVAL_LABEL_MODEL=claude-opus-5-5

# Drempels
TREND_MIN_COUNT=10
# Onder deze confidence gaat een rapport naar de controlebak (0..1)
EXTRACTION_MIN_CONFIDENCE=0.7
# Maximale dienstduur in uren voordat het rapport naar de controlebak gaat
MAX_SHIFT_HOURS=16

# Inbound e-mail (Mailgun, EU-regio) — ook als Supabase secret zetten voor de Edge Function
MAILGUN_WEBHOOK_SIGNING_KEY=
# Domein van de inbound-adressen: <inbound_alias>@<INBOUND_DOMAIN>
INBOUND_DOMAIN=in.veryo.nl
