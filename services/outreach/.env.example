# Veryo Outreach — kopieer naar services/outreach/.env en vul in. Nooit .env committen.

# shadow = mails worden concepten in de inbox (standaard); live = echt versturen
OUTREACH_MODE=shadow
# Noodstop: true = er wordt niets verstuurd of als concept gezet
OUTREACH_PAUSED=false

# Harde limieten (code weigert waarden boven 50 per dag / 20 per week)
OUTREACH_MAX_EMAILS_PER_DAY=25
OUTREACH_MAX_NEW_LEADS_PER_WEEK=10

# Verzendvenster op werkdagen, lokale tijd
OUTREACH_TIMEZONE=Europe/Amsterdam
OUTREACH_SEND_WINDOW_START=07:30
OUTREACH_SEND_WINDOW_END=10:00
# Verzenden stopt als de afmeldlijst langer dan dit niet met Notion gesynchroniseerd is
OUTREACH_SUPPRESSION_MAX_AGE_MINUTES=120

OUTREACH_SENDER_EMAIL=info@veryo.nl
OUTREACH_SENDER_NAME=Csaba
# Meldingen (escalaties, weekrapport) gaan naar dit adres
OUTREACH_ESCALATION_EMAIL=

OUTREACH_SCAN_LINK=https://veryo.nl/waar-begin-ik-met-ai/#ai-scan
OUTREACH_CALENDLY_LINK=https://calendly.com/csabahamstra/30min

# Lokale SQLite-database (verzendlog, auditlog, afmeldlijst); op de server op een volume
OUTREACH_DB_PATH=./data/outreach.sqlite

# Notion: interne integratie (notion.so/profile/integrations), gedeeld met de pagina
# "Veryo > Outreach (automatisch)"
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=3f3660c5-e796-81e3-9d17-cfc08e6f3793
NOTION_LEADS_DATA_SOURCE_ID=509eaca6-80e3-48d8-8383-8bf7d28ca3a9
NOTION_SUPPRESSION_DATA_SOURCE_ID=b8df4f79-a82d-4717-9d31-70e1e088dab3
